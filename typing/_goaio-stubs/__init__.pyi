"""_goaio: the Go half of goaio (package aio), built by aio.Configure.

Handles (loops, connections, listeners, selectors, channel operations) are ints. A call
that fails returns (None, errno, message), which goaio raises as OSError.
"""

from collections.abc import Buffer
from typing import Any, Final, TypeAlias, TypedDict, type_check_only

# A failure result: (None, errno, message); a negative errno is a name resolution error.
_Failure: TypeAlias = tuple[None, int, str]
# A completion: (token, kind, a, b), kind one of goaio's EV_* constants.
_Event: TypeAlias = tuple[int, int, Any, Any]

@type_check_only
class _TLSSpec(TypedDict):
    """A TLS configuration for crypto/tls (goaio_tls.go_config)."""

    server_side: bool
    server_hostname: str
    verify_mode: int
    check_hostname: bool
    check_common_name: bool
    min_version: int
    max_version: int
    ciphers: list[str]
    curves: list[str]
    alpn: list[str]
    keylog: str
    no_tickets: bool
    certs: list[tuple[str, str]]
    cafiles: list[str]
    capaths: list[str]
    cadata: list[str | bytes]
    handshake_timeout_ms: int

# The modules aio serves from source (goaio, goaio_tls, and those added with AddSource).
SOURCES: Final[dict[str, str]]

# Proactor loop (GoEventLoop).
def new_loop() -> int: ...
def close_loop(loop: int, /) -> None: ...
def wakeup(loop: int, /) -> None: ...
def poll(loop: int, timeout: float | None, /) -> list[_Event]: ...
def dial(loop: int, token: int, host: str, port: int, /) -> None: ...
def dial_tls(loop: int, token: int, host: str, port: int, spec: _TLSSpec, /) -> _Failure | None: ...
def resolve(loop: int, token: int, host: str, /) -> None: ...
def listen(loop: int, token: int, host: str, port: int, backlog: int, /) -> tuple[int, int] | _Failure: ...
def listen_tls(loop: int, token: int, host: str, port: int, backlog: int, spec: _TLSSpec, /) -> tuple[int, int] | _Failure: ...
def close_listener(listener: int, /) -> None: ...
def pipe(loop: int, fd: int, /) -> int | _Failure: ...
def watch_hangup(conn: int, /) -> None: ...
def wait_pid(loop: int, token: int, pid: int, /) -> None: ...

# Connections.
def peername(conn: int, /) -> tuple[str, int] | None: ...
def sockname(conn: int, /) -> tuple[str, int] | None: ...
def tls_state(conn: int, /) -> tuple[str, str, int, str, list[bytes]] | None: ...
def set_low_water(conn: int, token: int, low: int, /) -> None: ...
def start_reading(conn: int, token: int, /) -> None: ...
def start_reading_into(conn: int, token: int, /) -> None: ...
def read_into(conn: int, buffer: Buffer, /) -> int | None: ...
def pause_reading(conn: int, /) -> None: ...
def resume_reading(conn: int, /) -> None: ...
def write(conn: int, data: bytes, /) -> int: ...
def write_eof(conn: int, /) -> None: ...
def close(conn: int, /) -> None: ...
def abort(conn: int, /) -> None: ...

# Readiness selector (GoSelector); with a loop, its reports are the loop's EV_READY.
def sel_new(loop: int = ..., /) -> int: ...
def sel_register(selector: int, fd: int, events: int, /) -> _Failure | None: ...
def sel_modify(selector: int, fd: int, events: int, /) -> None: ...
def sel_unregister(selector: int, fd: int, /) -> None: ...
def sel_poll(selector: int, timeout: float | None, /) -> list[tuple[int, int]]: ...
def sel_close(selector: int, /) -> None: ...

# Go channels: (status, value), status 0 ready, 1 closed, 2 pending (value: the
# operation), 3 an error (value: its message).
def channel_send(channel: int, loop: int, token: int, value: Any, /) -> tuple[int, Any]: ...
def channel_recv(channel: int, loop: int, token: int, /) -> tuple[int, Any]: ...
def channel_cancel(operation: int, /) -> None: ...
def channel_close(channel: int, /) -> None: ...
